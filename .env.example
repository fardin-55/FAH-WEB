# ==============================================================================
# ShieldScan Environment Configuration Template
# All production and integration secrets must be defined here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Base Settings
# ------------------------------------------------------------------------------
# Primary public origin URL for app metadata, OAuth redirects, and canonical links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth / Auth JS secret token for encrypting JWT sessions and cookies
NEXTAUTH_SECRET=your_nextauth_secret_32_chars_minimum

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# PostgreSQL / Supabase connection URI for persistent user accounts, history, and scans
DATABASE_URL=postgresql://postgres:password@localhost:5432/shieldscan?sslmode=require

# ------------------------------------------------------------------------------
# 3. Authentication Providers (OAuth)
# ------------------------------------------------------------------------------
# Google OAuth Client ID for passwordless authentication
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# GitHub OAuth App Client ID
GITHUB_CLIENT_ID=your_github_client_id
# GitHub OAuth App Client Secret
GITHUB_CLIENT_SECRET=your_github_client_secret

# ------------------------------------------------------------------------------
# 4. Stripe Billing & Subscriptions
# ------------------------------------------------------------------------------
# Public client-side Stripe key for initializing Stripe Elements & Checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51PlaceholderPublishableKeyForShieldScan

# Secret server-side Stripe key for managing customer portals, subscriptions, and charges
STRIPE_SECRET_KEY=sk_test_51PlaceholderSecretKeyForShieldScan

# Webhook signing secret for verifying Stripe webhook events (/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_signing_secret

# Stripe Price IDs for Pro tier plans
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=price_placeholder_pro_monthly
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=price_placeholder_pro_yearly

# ------------------------------------------------------------------------------
# 5. External Threat Detection & Domain Intelligence APIs
# ------------------------------------------------------------------------------
# Google Safe Browsing API Key for checking URLs against official malware & phishing lists
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key

# VirusTotal v3 API Key for comprehensive file/URL antivirus scanner aggregate analysis
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# WhoisXML / DomainTools API key for domain registration dates, expiration, and registrar lookup
WHOIS_XML_API_KEY=your_whois_xml_api_key

# ------------------------------------------------------------------------------
# 6. Upstash Redis (Rate Limiting & Caching)
# ------------------------------------------------------------------------------
# Upstash Redis REST URL for distributed rate limiting on free tier scans & API routes
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io

# Upstash Redis REST Token for secure serverless Redis requests
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ------------------------------------------------------------------------------
# 7. LLM AI Phishing & Spam Analysis API
# ------------------------------------------------------------------------------
# OpenAI / Anthropic API Key for advanced semantic phishing analysis & explanation generation
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=gpt-4o-mini

